// The demo Worker. Resource ids are not in this public repository: the KV
// namespace id below is for `wrangler dev`; Workers Builds puts the real one
// in at deploy time (scripts/deploy-config.mjs). Secrets: see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pointsman-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Pointsman runs on workers.dev in the same account: without this, a fetch
  // to it would not leave the account's own network.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "vars": {
    "POINTSMAN_URL": "https://pointsman.geolonia.workers.dev",
    "BROKER_URL": "https://geolonia-demo.geonicdb.jp",
    "BROKER_TENANT": "pointsman_demo",
    "GITHUB_REPOSITORY": "geolonia/pointsman-demo",
    "GITHUB_APP_ID": "5219531",
    "GITHUB_INSTALLATION_ID": "168739763",
    "DAILY_LIMIT": "300",
    "ALLOWED_ORIGINS": "https://geolonia.github.io,http://localhost:8765"
  },
  "kv_namespaces": [{ "binding": "DEMO", "id": "local-dev-only" }],
  // Reports per visitor (IP) and minute.
  "ratelimits": [{ "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Hourly: delete demo data older than a day.
  "triggers": { "crons": ["17 * * * *"] }
}
